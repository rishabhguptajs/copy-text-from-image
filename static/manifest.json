{
  "manifest_version": 3,
  "name": "Copy Text from Image: Offline OCR",
  "short_name": "Copy Text from Image",
  "version": "1.0.3",
  "description": "Copy text from any image, video frame or unselectable text on a page. Runs 100% offline. Nothing is uploaded.",
  "author": "Raegent",
  "homepage_url": "https://raegent.com/ocr",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copy Text from Image",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "contextMenus", "offscreen", "clipboardWrite", "scripting", "storage"],
  "host_permissions": ["https://live.dodopayments.com/*"],
  "commands": {
    "select-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Select an area on the page and copy its text"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
